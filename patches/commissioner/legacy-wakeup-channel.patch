+// The generic TLV set intentionally drops invalid fields and collapses duplicates.
+// Validate this legacy compatibility field before using that permissive parser.
+static Error ValidateLegacyWakeupChannel(const ByteArray &aPayload)
+{
+    Error error;
+    size_t offset = 0;
+    bool seen = false;
+    while (offset < aPayload.size())
+    {
+        auto field = tlv::Tlv::Deserialize(error, offset, aPayload, tlv::Scope::kMeshCoP);
+        SuccessOrExit(error);
+        VerifyOrExit(field != nullptr, error = ERROR_BAD_FORMAT("Malformed dataset"));
+        if (field->GetType() == tlv::Type::kLegacyWakeupChannel)
+        {
+            VerifyOrExit(!seen && field->IsValid(), error = ERROR_BAD_FORMAT("Invalid legacy Wake-up Channel"));
+            seen = true;
+        }
+    }
+exit:
+    return error;
 }

